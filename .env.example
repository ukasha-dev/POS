# Copy this file to ".env" and fill in real values. The .env file is gitignored.
# .NET reads these automatically: "__" maps to the config section separator ":".

ConnectionStrings__DefaultConnection="Host=YOUR_NEON_HOST;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Channel Binding=Require;Trust Server Certificate=true"

Jwt__Key="YOUR_JWT_SIGNING_KEY_MIN_32_CHARS"
JwtSettings__SecretKey="YOUR_JWT_SECRET_KEY_MIN_32_CHARS"
